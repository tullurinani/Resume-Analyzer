# Copy to .env for local development. Never commit your real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite is the default. Use these for MySQL:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=resume_ai_db
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Optional SMTP settings. The console email backend is used by default.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=your-address@example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
